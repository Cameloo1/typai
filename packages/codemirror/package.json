{
  "name": "@typai/codemirror",
  "version": "0.0.0-beta.0",
  "description": "CodeMirror extension for Typai local correction and optional completion controllers.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cameloo1/typai.git",
    "directory": "packages/codemirror"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "clean": "node -e \"const fs=require('node:fs'); fs.rmSync('dist',{recursive:true,force:true});\""
  },
  "dependencies": {
    "@typai/core": "workspace:*",
    "@typai/ui": "workspace:*"
  },
  "peerDependencies": {
    "@codemirror/language": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@typai/adapter-testkit": "workspace:*",
    "jsdom": "^27.0.0"
  }
}
