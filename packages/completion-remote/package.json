{
  "name": "@typai/completion-remote",
  "version": "0.0.0-beta.0",
  "description": "Optional remote completion controller and endpoint-provider utilities for Typai.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
