{
  "name": "@typai/contenteditable",
  "version": "0.0.0-beta.0",
  "description": "Typai contenteditable adapter for local correction and optional completion controllers.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cameloo1/typai.git",
    "directory": "packages/contenteditable"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "prepack": "pnpm run build",
    "test": "vitest run --passWithNoTests",
    "clean": "node -e \"const fs=require('node:fs'); fs.rmSync('dist',{recursive:true,force:true});\""
  },
  "dependencies": {
    "@typai/core": "workspace:*"
  },
  "devDependencies": {
    "@typai/adapter-testkit": "workspace:*"
  }
}
